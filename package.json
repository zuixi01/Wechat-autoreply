{
  "name": "autoreply-desktop-agent",
  "version": "1.2.4",
  "description": "个人微信前台自动回复与企业回复服务",
  "main": "./out/main/index.js",
  "author": "autoreply-dev",
  "license": "Apache-2.0",
  "homepage": "https://github.com/zuixi01/Wechat-autoreply",
  "overrides": {
    "@mapbox/node-pre-gyp": "2.0.3",
    "node-gyp": "12.4.0",
    "tar": "7.5.22",
    "brace-expansion@^1.0.0": "1.1.21",
    "brace-expansion@^2.0.0": "2.1.7",
    "brace-expansion@^5.0.0": "5.0.12",
    "@tootallnate/once": "2.0.1",
    "fast-uri": "3.1.8",
    "ip-address": "10.7.3",
    "argparse": "2.0.1",
    "source-map-js": "1.2.2",
    "@xmldom/xmldom": "0.8.15",
    "tmp": "0.2.7",
    "app-builder-lib": {
      "@electron/get": "5.1.0"
    },
    "exceljs": {
      "uuid": "11.1.1"
    },
    "@hurdlegroup/robotjs": {
      "node-addon-api": "^8.7.0"
    }
  },
  "scripts": {
    "publish:foreground": "node scripts/publish-foreground.mjs",
    "test:workbench:feedback": "node scripts/run-desktop-smoke.mjs --latest-release --feedback-only",
    "test:native-probe": "node scripts/run-native-probe-fixture.mjs",
    "test:foreground-input": "node scripts/test-foreground-input.mjs",
    "test:device-credentials": "node scripts/run-device-credential-check.mjs",
    "probe:read": "tsx scripts/platform-probe.ts",
    "probe:compare": "tsx scripts/platform-probe-compare.ts",
    "legacy:migrate": "tsx scripts/legacy-settings-migrate.ts migrate",
    "legacy:inspect": "tsx scripts/legacy-settings-migrate.ts inspect",
    "legacy:review": "tsx scripts/legacy-settings-review.ts",
    "ledger:backup": "tsx scripts/ledger-recovery.ts backup",
    "ledger:verify": "tsx scripts/ledger-recovery.ts verify",
    "ledger:restore": "tsx scripts/ledger-recovery.ts restore",
    "ledger:inspect-restoration": "tsx scripts/ledger-recovery.ts inspect-restoration",
    "ledger:inspect-inventory": "tsx scripts/ledger-recovery.ts inspect-inventory",
    "test:knowledge:desktop": "node scripts/run-knowledge-smoke.mjs",
    "test:learning:desktop": "node scripts/run-learning-smoke.mjs",
    "test:learning:restart": "node scripts/run-learning-restart-smoke.mjs",
    "test:learning:publication": "node scripts/run-learning-publication-smoke.mjs",
    "test:learning:iteration": "node scripts/run-learning-iteration-smoke.mjs",
    "knowledge:prepare": "tsx server/scripts/prepare-knowledge.ts",
    "publish:native": "tsx scripts/publish-native.ts",
    "test:packaged-native": "node scripts/run-packaged-native-smoke.mjs",
    "test:dependencies": "node scripts/audit-dependencies.mjs",
    "test:desktop:release": "node scripts/run-desktop-smoke.mjs --latest-release",
    "test:desktop:software": "node scripts/run-desktop-smoke.mjs --latest-release --software-rendering",
    "verify:release": "npm test && npm run test:native-probe && npm run build:win:dev && npm run test:packaged-native && npm run test:desktop:release && npm run test:workbench:feedback",
    "test:unit": "vitest run tests/unit",
    "test:integration": "vitest run tests/integration",
    "test:desktop": "node scripts/run-desktop-smoke.mjs",
    "test:timing:desktop": "node scripts/run-workbench-presentation-smoke.mjs",
    "test:jev:contract": "vitest run tests/integration/jev-contract.test.ts",
    "test:regression": "vitest run tests/regression",
    "test:scenarios": "vitest run --config vitest.scenarios.config.ts",
    "test:postgres": "node scripts/run-postgres-concurrency.mjs",
    "test": "vitest run",
    "typecheck:services": "tsc --noEmit -p tsconfig.services.json",
    "verify": "npm run typecheck && npm run typecheck:services && npm run lint -- --quiet && npm test",
    "admin": "tsx server/scripts/admin.ts",
    "server:start": "tsx server/src/index.ts",
    "server:build": "node server/build-release.mjs",
    "server:release:check": "node scripts/check-server-release.mjs",
    "server:check": "tsx server/scripts/server-check.ts",
    "admin:serve": "tsx server/scripts/admin-server.ts",
    "jev:check": "tsx server/scripts/jev-check.ts",
    "jev:demo": "tsx server/scripts/jev-demo.ts",
    "jev:calibrate": "tsx server/scripts/jev-calibrate.ts",
    "jev:settlements": "tsx server/scripts/jev-settlements.ts",
    "test:mainline": "vitest run tests/integration/auto-reply-mainline.test.ts tests/integration/jev-http-mainline.test.ts tests/integration/jev-contract.test.ts tests/integration/jev-pipeline.test.ts tests/integration/remote-reply-service.test.ts tests/integration/conversation-collector.test.ts tests/regression/agent-workflow.test.ts tests/regression/sender-races.test.ts tests/unit/scheduler.test.ts",
    "jev:evaluate": "tsx server/scripts/jev-evaluate.ts",
    "eval:jev": "tsx server/scripts/jev-replay.ts",
    "memory:evaluate": "tsx scripts/memory-evaluate.ts",
    "memory:replay": "tsx scripts/memory-replay.ts replay",
    "memory:replay:enterprise": "tsx server/scripts/memory-replay.ts",
    "memory:adjudicate": "tsx scripts/memory-replay.ts adjudicate",
    "format": "prettier --write .",
    "lint": "eslint --cache .",
    "typecheck:node": "tsc --noEmit -p tsconfig.node.json --composite false",
    "typecheck:web": "tsc --noEmit -p tsconfig.web.json --composite false",
    "typecheck": "npm run typecheck:node && npm run typecheck:web",
    "start": "electron-vite preview",
    "dev": "node scripts/dev-launch.mjs",
    "build": "node scripts/prepare-foreground.mjs && npm run typecheck && electron-vite build",
    "postinstall": "electron-builder install-app-deps",
    "build:unpack": "npm run build && electron-builder --dir",
    "build:win": "npm run test:dependencies && npm run publish:native && npm run publish:foreground && npm run build && electron-builder --win --x64",
    "build:win:dev": "node scripts/build-windows-dev.mjs",
    "build:win:installer:dev": "node scripts/build-windows-dev.mjs --installer",
    "build:mac": "electron-vite build && electron-builder --mac",
    "build:linux": "electron-vite build && electron-builder --linux",
    "test:personal": "vitest run tests/unit/foreground-wechat.test.ts tests/unit/foreground-wechat-driver.test.ts tests/unit/foreground-journal.test.ts tests/unit/foreground-batch.test.ts tests/integration/personal-wechat-flow.test.ts",
    "clean:artifacts": "tsx scripts/clean-artifacts.ts",
    "test:wechat": "node scripts/run-personal-wechat-test.mjs"
  },
  "dependencies": {
    "@electron-toolkit/utils": "^4.0.0",
    "@hurdlegroup/robotjs": "^0.12.3",
    "active-win": "^8.2.1",
    "electron-store": "^11.0.2",
    "exceljs": "^4.4.0",
    "jimp": "^1.6.1",
    "mammoth": "^1.13.0",
    "node-window-manager": "^2.2.4",
    "pdfjs-dist": "^6.3.289",
    "pg": "^8.23.1",
    "pixelmatch": "^7.1.0",
    "pngjs": "^7.0.0",
    "zod": "^4.6.0"
  },
  "devDependencies": {
    "@electric-sql/pglite": "^0.5.8",
    "@electron-toolkit/eslint-config-prettier": "^3.0.0",
    "@electron-toolkit/eslint-config-ts": "^3.1.0",
    "@electron-toolkit/tsconfig": "^2.0.0",
    "@types/node": "^22.19.1",
    "@types/pg": "^8.23.1",
    "@types/pngjs": "6.0.5",
    "@types/react": "^19.2.7",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^5.1.1",
    "adm-zip": "0.6.1",
    "electron": "44.5.1",
    "electron-builder": "26.15.3",
    "electron-vite": "^5.0.0",
    "eslint": "^9.39.1",
    "eslint-plugin-react": "^7.37.5",
    "eslint-plugin-react-hooks": "^7.0.1",
    "eslint-plugin-react-refresh": "^0.4.24",
    "js-yaml": "4.3.2",
    "prettier": "^3.7.4",
    "react": "^19.2.1",
    "react-dom": "^19.2.1",
    "tsx": "^4.20.0",
    "typescript": "^5.9.3",
    "vite": "^7.2.6",
    "vitest": "^4.1.0"
  }
}
