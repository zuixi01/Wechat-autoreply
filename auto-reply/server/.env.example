# Server-side only. Do not distribute secrets to employee clients.
TYPESAFE_API_KEY=
# Explicit evaluation key for eval:jev execute; may incur charges.
JEV_API_KEY=
JEV_MODEL=
JEV_EXPECTED_MODEL=
# Text-model provider is independent of Jev. Use an explicitly validated endpoint/model.
TEXT_MODEL_API_KEY=
TEXT_MODEL_BASE_URL=
TEXT_MODEL_ID=
TEXT_MODEL_EXPECTED_ID=
DATABASE_URL=
# Dedicated non-superuser administrator login, mapped by the migration operator.
# Never use this for the normal HTTP service or employee clients.
ADMIN_DATABASE_URL=
# Independent administrator HTTPS gateway; token is 32 random bytes in base64url.
ADMIN_TENANT_ID=
ADMIN_GATEWAY_TOKEN=
ADMIN_BIND_HOST=127.0.0.1
ADMIN_PORT=4783
ADMIN_TLS_CERT_PATH=
ADMIN_TLS_KEY_PATH=
# Separate account-scoped business reviewer login, member of autoreply_jev_reviewer only.
# Used by eval:jev review-submit; never give reviewers the administrator URL or model keys.
REVIEW_DATABASE_URL=
# Normal API database credentials must have neither superuser nor BYPASSRLS.
BIND_HOST=127.0.0.1
PORT=4782
TLS_CERT_PATH=
TLS_KEY_PATH=
# Explicit development exception restricted to loopback. Never use for employee deployment.
DEV_ALLOW_LOCAL_HTTP=0
